# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MongoDB Connection String (defaults to Mongo Memory Server in preview if omitted)
MONGODB_URI="mongodb+srv://user:password@cluster.mongodb.net/leaddesk?retryWrites=true&w=majority"

# JWT Secret for admin authentication
JWT_SECRET="leaddesk-mini-jwt-secret-key-change-in-production"

# Default Admin Credentials for Seed Bootstrap
ADMIN_EMAIL="admin@leaddesk.com"
ADMIN_SEED_PASSWORD="LeadDesk@Admin"

# Allowed CORS client origin in production (e.g., https://leaddesk-mini.vercel.app)
CLIENT_ORIGIN="https://leaddesk-mini.vercel.app"

